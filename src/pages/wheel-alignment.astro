const offerHighlights = [
  "$35 comes off your final alignment price",
  "Same discount for front-end or four-wheel",
  "Available for most vehicles",
];

const promises = [
  {
    title: "Same Savings Either Way",
    body: "Need a front-end or a four-wheel alignment? Take $35 off the final alignment price either way.",
    icon: "M3 7V3h4l13 13-4 4L3 7Zm3-1h.01",
  },
  {
    title: "Know the Price First",
    body: "You’ll get your price before work starts. Extra adjustments or parts may cost more.",
    icon: "M7 3h7l4 4v14H7zM14 3v5h4M10 12h5m-5 4h5",
  },
  {
    title: "Request a Time Online",
    body: "Enter your contact and vehicle details, then choose the day and time that work for you.",
    icon: "M4 6h16v14H4zM8 3v5m8-5v5M4 10h16m-11 5 2 2 4-4",
  },
  {
    title: "Visit the Dundee Ave Shop",
    body: "Coming in for your alignment? You’ll find Queens Auto Service at 1303 Dundee Ave in Elgin.",
    icon: "M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Zm-5 0a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z",
  },
];

const signs = [
  {
    title: "You keep nudging the wheel",
    body: "Even on a straight, flat road, the car drifts left or right unless you correct it.",
    icon: "M5 21V3m14 18V3M10 19c0-6 1-10 5-13m-4 0h4v4",
  },
  {
    title: "Your steering wheel looks crooked",
    body: "You’re driving straight and the steering wheel still looks turned.",
    icon: "M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0ZM3.5 10.5l6 1.5m5 0 6-1.5M12 14v7m2.5-9a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0Z",
  },
  {
    title: "One edge of a tire is wearing faster",
    body: "Look at both edges of the tread. One side may look worn down while the rest still has tread left.",
    icon: "M8 3h8a3 3 0 0 1 3 3v12a3 3 0 0 1-3 3H8a3 3 0 0 1-3-3V6a3 3 0 0 1 3-3Zm0 4 3 2m2-2 3 2m-8 3 3 2m2-2 3 2m-8 3 3 2m2-2 3 2",
  },
  {
    title: "It started after a pothole or curb hit",
    body: "Mention the hit when you call, especially if the car started pulling or the wheel went off-center afterward.",
    icon: "M8 5v14m8-14v14M5 8v8m14-8v8M12 3v18",
  },
];

const benefits = [
  {
    title: "Get more miles from your tires",
    body: "When a wheel sits at the wrong angle, one edge of the tread can wear out early. Correcting that angle helps spread the wear more evenly.",
    icon: "M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-5 0a4 4 0 1 1-8 0 4 4 0 0 1 8 0ZM12 3v2m0 14v2M3 12h2m14 0h2",
  },
  {
    title: "Make fewer steering corrections",
    body: "If the alignment is causing the pull, correcting it can help the car track straighter.",
    icon: "M5 21 9 3m10 18L15 3m-3 1v2m0 4v3m0 4v3",
  },
];

const shopHours = [
  "Mon–Fri, 7:30 AM–6 PM",
  "Sat, 7:30 AM–4 PM",
];

const faqs = [
  {
    question: "What will I pay for a wheel alignment?",
    answer:
      "You’ll get the price before work starts. The offer takes $35 off the final alignment price for most vehicles, and extra adjustments or parts may cost more.",
  },
  {
    question: "Do I still get $35 off if I need a four-wheel alignment?",
    answer:
      "Yes. The same $35 comes off the final price of a front-end or four-wheel alignment.",
  },
  {
    question: "How do I know if I actually need an alignment?",
    answer:
      "A pull on a flat road, a crooked steering wheel, or tread worn on one edge are reasons to ask about an alignment. Those signs alone don’t tell you the cause. Mention what you’re noticing when you call.",
  },
  {
    question: "Should I get the alignment checked after hitting a pothole?",
    answer:
      "It’s worth asking if the car pulls or the steering wheel sits crooked after a pothole or curb hit. An impact can affect alignment or damage a tire or suspension part.",
  },
  {
    question: "Will an alignment undo uneven tire wear?",
    answer:
      "Tread that’s already worn stays worn. If misalignment caused the wear, correcting it can help the remaining tread wear more evenly.",
  },
  {
    question: "What if the shop recommends extra work?",
    answer:
