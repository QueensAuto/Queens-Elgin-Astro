---
import LandingLayout from "../layouts/LandingLayout.astro";
import BookingForm from "../components/BookingForm.astro";
import reviews from "../data/landing-reviews/repair.json";
import { mobileTiresBrand as brand } from "../brands";

const title = "Auto Repair in Elgin, IL — Save Up to $45 | Queens Auto";
const description =
  "Need auto repair in Elgin? Take $15 off $100+, $30 off $200+, or $45 off $300+ on repairs, maintenance, and diagnostics. Book online—no payment up front.";

const phoneDigits = brand.phone.replace(/\D/g, "");

const tiers = [
  { spend: "$100–$199", save: "$15 OFF", highlight: false },
  { spend: "$200–$299", save: "$30 OFF", highlight: false },
  { spend: "$300+", save: "$45 OFF", highlight: true },
];

const promises = [
  {
    title: "Bigger Bill, Bigger Savings",
    body: "Spend $100–$199 for $15 off, $200–$299 for $30 off, or $300+ for $45 off your final bill on repairs, maintenance, or diagnostics.",
    icon: "M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
  },
  {
    title: "Price Confirmed First",
    body: "Nothing starts until you hear the price and give the green light. No surprise charges added to your bill without your OK.",
    icon: "M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z",
  },
  {
    title: "Book in Under a Minute",
    body: "No payment online. Pick your day and time below, and tell us what your car is doing in the optional notes box on step 2.",
    icon: "M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z",
  },
  {
    title: "24/24 Repair Warranty",
    body: "Most repairs at our Dundee Ave shop carry a 24-month / 24,000-mile warranty—ask about coverage when your price is reviewed.",
    icon: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
  },
];

const warningIcon = "M10.3 4L2.5 18a2 2 0 0 0 1.7 3h15.6a2 2 0 0 0 1.7-3L13.7 4a2 2 0 0 0-3.4 0ZM12 9v4m0 4h.01";

const signs = [
  {
    icon: warningIcon,
    title: "Check engine light that won't go off",
    body: "Steady or flashing, a warning light means something needs a closer look—and diagnostics qualify for the same $15–$45 tiers.",
  },
  {
    icon: "M11 5 6 9H3v6h3l5 4V5Zm4 4a4 4 0 0 1 0 6m3-9a8 8 0 0 1 0 12",
    title: "A squeal, clunk, or hum that just started",
    body: "New sounds when you brake, turn, or speed up are easier to pin down before worn parts start affecting what's next to them.",
  },
  {
    icon: "M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z",
    title: "Spots on the driveway or a burning smell",
    body: "Drips under a parked car or a sweet, oily, or sharp smell under the hood are signs to get a look before a fluid runs low.",
  },
  {
    icon: "M14 14.76V3.5a2.5 2.5 0 0 0-5 0v11.26a4.5 4.5 0 1 0 5 0Z",
    title: "Overheating, rough idle, or slow starts",
    body: "A climbing temperature gauge or sluggish cranking is worth checking while you can still drive in on your own schedule.",
  },
];

const checklist = [
  "<strong>Spend $100–$199 → $15 off</strong> your final bill",
  "<strong>Spend $200–$299 → $30 off</strong> your final bill",
  "<strong>Spend $300+ → $45 off</strong> your final bill",
  "Applies to auto repairs, maintenance, and diagnostics",
  "Price confirmed before any work starts · No payment online",
  "Excludes tires and batteries · One coupon per visit · Limited time",
];

const features = [
  {
    title: "Repairs ($300+ → $45 Off)",
    body: "Putting off a repair because of the bill? Any qualifying repair of $300 or more knocks $45 straight off your total, backed by a 24-month / 24,000-mile warranty on most repairs.",
  },
  {
    title: "Diagnostics & Warning Lights",
    body: "Not sure what's behind a check engine light or strange noise yet? Diagnostic visits count toward the $100, $200, and $300 tiers just like repairs.",
  },
  {
    title: "Routine Maintenance ($100+ → $15–$30 Off)",
    body: "Coming in for scheduled maintenance? Hit $100–$199 and take $15 off your final bill, or reach $200–$299 to take $30 off.",
  },
  {
    title: "What's Excluded & Coupon Rules",
    body: "Tires and batteries are excluded from this offer. One coupon per visit—it can't be stacked with other offers. It's a discount on your final bill, not a fixed price.",
  },
];

const pains = [
  {
    icon: "M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z",
    title: "A slow leak rarely stays cheap",
    body: "Driving low on fluids adds heat and wear to surrounding parts—turning a smaller repair into a bigger bill later.",
  },
  {
    icon: warningIcon,
    title: "One worn part pulls on the rest",
    body: "A misfire, vibration, or ignored warning light puts extra strain on neighboring components every mile you put it off.",
  },
  {
    icon: "M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z",
    title: "Book on your schedule and take up to $45 off",
    body: "Pick a time that fits your week instead of waiting for a breakdown—and take $15, $30, or $45 off while this offer is running.",
  },
];

const cities = [
  "Elgin, IL",
  "South Elgin, IL",
  "Carpentersville, IL",
  "East Dundee, IL",
  "West Dundee, IL",
  "Gilberts, IL",
  "Algonquin, IL",
  "Huntley, IL",
  "Hoffman Estates, IL",
  "Barrington, IL",
];

const faqs = [
  {
    question: "How do the $15, $30, and $45 discount tiers work?",
    answer:
      "Your discount comes off your final bill based on your qualifying visit total: spend $100–$199 for $15 off, $200–$299 for $30 off, or $300 or more for $45 off. It's a discount on your final bill, not a fixed price.",
  },
  {
    question: "Does this apply to diagnostics and maintenance, or only repairs?",
    answer:
      "It applies to all three—auto repairs, routine maintenance, and diagnostics at our Elgin shop.",
  },
  {
    question: "What's excluded, and can I combine this with another coupon?",
    answer:
      "It's an online-exclusive offer, so book through this page to claim it. Tires and batteries are excluded from this promotion. Only one coupon is allowed per visit, so it can't be combined with other offers. Some restrictions may apply, and the offer is for a limited time only.",
  },
  {
    question: "How do I know the price before you start working on my car?",
    answer:
      "The price is confirmed with you before any work starts. You don't pay anything online when booking—reserving your slot takes under a minute, and you can describe what's going on with your car in the optional box on the time step.",
  },
  {
    question: "Are repairs covered by a warranty?",
    answer:
      "Yes—most repairs at Queens Auto Service include a 24-month / 24,000-mile warranty. Ask our team about warranty coverage for your specific repair when we confirm your price.",
  },
  {
    question: "Where are you located and what are your hours?",
    answer:
      "We're at 1303 Dundee Ave, Elgin, IL 60120, open Monday–Friday 7:30 AM–6:00 PM and Saturday 7:30 AM–4:00 PM. Have a question before booking? Call (224) 635-3000.",
  },
];
---

<LandingLayout title={title} description={description} brand={brand} faqData={faqs} reviewData={reviews}>
  <!-- ============ HERO ============ -->
  <section class="lp-hero">
    <div class="lp-wrap ar-hero-wrap pb-14 md:pb-20">
      <div class="ar-hero-grid">
        <div class="ar-intro">
          <p class="ar-symptom">
            <!-- diagnostic pulse + check-engine indicator mark -->
            <svg class="ar-symptom-mark" viewBox="0 0 64 22" aria-hidden="true" focusable="false">
              <path
                class="ar-pulse-line"
                pathLength="1"
                d="M1 12 H15 L19 5 L23 18 L27 9 L31 12 H41"
              />
              <g class="ar-engine-icon">
                <path
                  pathLength="1"
                  d="M46 8 h8 l2 2 h3 v6 h-3 l-2 2 h-8 l-2-2 v-6 z M49 6 v2 M53 6 v2 M43 11 v4"
                />
              </g>
            </svg>
            <span>Warning light, leak, or new noise?</span>
          </p>

          <h1 class="lp-h1 mt-4">
            Need Auto Repair in Elgin? <span class="lp-grad">Save Up to $45</span>
          </h1>

          <p class="ar-sub text-lg text-slate-300">
            Whether it's a check engine light, a new noise, or a repair you've
            been putting off, take $15 to $45 off your final bill at our Dundee
            Ave shop — price confirmed before any work starts.
          </p>

          <!-- Mobile / tablet quick-offer block (hidden >=1024px) -->
          <div class="ar-quick-offer">
            <div class="ar-quick-tiers" role="list" aria-label="Discount tiers">
              {
                tiers.map((t) => (
                  <div class={`ar-quick-tier ${t.highlight ? "is-top" : ""}`} role="listitem">
                    <span class="ar-quick-spend">Spend {t.spend}</span>
                    <strong class="ar-quick-save">{t.save}</strong>
                  </div>
                ))
              }
            </div>
            <p class="ar-quick-scope">Repairs, maintenance &amp; diagnostics · Excl. tires &amp; batteries</p>
            <a href="#book" class="lp-btn">Book &amp; Save Up to $45 →</a>
            <p class="ar-reassure">
              <strong style="color:#22d3ee;font-weight:700">Online&nbsp;exclusive</strong> · No&nbsp;payment&nbsp;online · Book&nbsp;in&nbsp;under&nbsp;a&nbsp;minute · Price&nbsp;confirmed&nbsp;first
            </p>
          </div>
        </div>

        <!-- Hero visual: real Elgin shop engine bay & diagnostic photo -->
        <div class="ar-stage">
          <img
            class="ar-stage-img"
            src="/images/services/Queens-Auto-repair-1024x670.webp"
            alt="Technician working under the hood of an SUV in a Queens Auto Service bay in Elgin"
            width="1024"
            height="670"
            fetchpriority="high"
          />
          <div class="ar-stage-badge">
            <span class="ar-stage-dot" aria-hidden="true"></span>
            <span>1303 Dundee Ave · Elgin since 2007</span>
          </div>
        </div>

        <!-- Full offer tiers + CTA block (visible in left col on desktop, below image on mobile) -->
        <div class="ar-offer">
          <div class="ar-tiers" role="list" aria-label="Auto repair discount tiers">
            {
              tiers.map((t) => (
                <div class={`ar-tier ${t.highlight ? "is-top" : ""}`} role="listitem">
                  <span class="ar-tier-spend">Spend {t.spend}</span>
                  <span class="ar-tier-save">{t.save}</span>
                </div>
              ))
            }
          </div>
          <p class="ar-tier-note">
            Discount comes off your <strong class="text-white">final bill</strong> on repairs, maintenance, and diagnostics — not a fixed price.
          </p>

          <div class="ar-hero-actions flex flex-col sm:flex-row gap-3">
            <a href="#book" class="lp-btn">Book &amp; Save Up to $45 →</a>
            <a href={`tel:${phoneDigits}`} class="lp-btn lp-btn-ghost">Call {brand.phone}</a>
          </div>
          <p class="ar-reassure">
            <strong style="color:#22d3ee;font-weight:700">Online&nbsp;exclusive</strong> · No&nbsp;payment&nbsp;online · Book&nbsp;in&nbsp;under&nbsp;a&nbsp;minute · Price&nbsp;confirmed&nbsp;before&nbsp;work&nbsp;starts
          </p>

          <p class="mt-5 flex items-center gap-2 text-sm text-slate-400">
            <span class="lp-stars tracking-wide" aria-hidden="true">★★★★★</span>
            <span>
              <strong class="text-white">{brand.ratingValue}</strong> on Google from {brand.reviewCount} reviews · 24-mo / 24k-mi warranty on most repairs
            </span>
          </p>

          <details class="ar-restrictions mt-3 text-xs text-slate-400">
            <summary class="cursor-pointer inline">
              Excludes tires &amp; batteries. <span class="underline text-white font-semibold">See offer terms</span>
            </summary>
            <p class="mt-2 max-w-md leading-relaxed">
              Online-exclusive offer: book through this page to claim it.
              Discount applies to your final bill: $15 off $100–$199,
              $30 off $200–$299, or $45 off $300+ on repairs, maintenance, and
              diagnostics. Excludes tires and batteries. One coupon per visit.
              Some restrictions may apply. Limited time only.
            </p>
          </details>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ PROMISE ============ -->
  <section class="lp-section">
    <div class="lp-wrap">
      <div class="lp-head reveal">
        <h2 class="lp-h2">How Your <span class="lp-grad">Up to $45 Off</span> Visit Works</h2>
        <p>
          Bigger bills hurt less when your discount scales with the job — and
          nothing starts until you approve the price.
        </p>
      </div>
      <div class="mt-12 grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {
          promises.map((p) => (
            <div class="lp-card text-center reveal">
              <div class="lp-icon mx-auto">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d={p.icon} />
                </svg>
              </div>
              <h3 class="lp-h3 mt-5">{p.title}</h3>
              <p class="mt-2 text-sm text-slate-400 leading-relaxed">{p.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ BOOKING FORM ============ -->
  <section id="book" class="lp-section lp-book">
    <div class="lp-wrap">
      <BookingForm
        fullDark
        presetService="Auto Repair"
        promoCode="auto_repair_45"
        step1TitleHighlight="Secure Your Spot"
        step1Description="Step 1 of 2 — Your contact and vehicle details."
        step3Description="Step 2 of 2 — Pick your preferred time."
      />
    </div>
  </section>

  <!-- ============ REVIEWS ============ -->
  <section class="lp-section" id="reviews">
    <div class="lp-wrap">
      <div class="lp-head reveal">
        <h2 class="lp-h2">Rated <span class="lp-grad">4.7★ on Google</span> by Elgin Drivers</h2>
        <p>
          With {brand.reviewCount} Google reviews since 2007, here's a sample of
          what local drivers wrote after visiting our Dundee Ave shop.
        </p>
      </div>
      <div class="mt-12 grid md:grid-cols-2 lg:grid-cols-3 gap-5">
        {
          reviews.map((r) => (
            <figure class="lp-card reveal flex flex-col">
              <div class="lp-stars" aria-label={`${r.stars} out of 5 stars`}>
                {"★".repeat(r.stars)}
              </div>
              <blockquote class="mt-3 text-slate-200 leading-relaxed grow">
                “{r.text}”
              </blockquote>
              <figcaption class="mt-5 pt-4 border-t border-white/10 text-sm">
                <span class="text-white font-semibold">{r.name === "Google reviewer" ? "Google review" : r.name}</span>
                <span class="text-slate-500"> · {r.date}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ WARNING SIGNS ============ -->
  <section class="lp-section">
    <div class="lp-wrap">
      <div class="lp-head reveal">
        <h2 class="lp-h2">Light On, New Noise, or Putting Off a Fix?</h2>
        <p>
          If something feels off with your car, your Up to $45 Off discount
          covers diagnostics too — not just the repair after.
        </p>
      </div>
      <div class="mt-12 grid md:grid-cols-2 gap-10 lg:gap-16 items-center">
        <div>
          <h3 class="lp-h3 mb-5">What brings Elgin drivers into the bay</h3>
          <ul class="space-y-5">
            {
              signs.map((s) => (
                <li class="flex gap-4 reveal">
                  <svg class="lp-line-icon mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d={s.icon} />
                  </svg>
                  <div>
                    <strong class="text-white">{s.title}</strong>
                    <p class="text-slate-400 mt-0.5">{s.body}</p>
                  </div>
                </li>
              ))
            }
          </ul>
          <div class="mt-8">
            <h3 class="lp-h3">Know the price before any work starts</h3>
            <p class="mt-2 text-slate-300">
              Tell us what's going on with your car in the optional box on the
              time step. At the shop, the price is confirmed with your $15, $30,
              or $45 discount before any work begins.
            </p>
            <a href="#book" class="lp-btn mt-5">Book &amp; Save Up to $45 →</a>
          </div>
        </div>
        <div class="lp-photo">
          <img
            src="/images/services/Queens-Auto-Sevrices-Mechanical-Work-001.webp"
            alt="Open engine bay during mechanical service inside Queens Auto Service in Elgin"
            loading="lazy"
            width="920"
            height="517"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ============ WHAT IT COVERS ============ -->
  <section class="lp-section">
    <div class="lp-wrap">
      <div class="grid md:grid-cols-2 gap-10 lg:gap-16 items-center">
        <div class="lp-photo">
          <img
            src="/images/services/Auto-Repair-001.webp"
            alt="Technician working on an engine assembly with a ratchet wrench at Queens Auto Service"
            loading="lazy"
            width="800"
            height="800"
          />
        </div>
        <div>
          <h2 class="lp-h2">Does Your Repair Qualify? What's Covered &amp; Excluded</h2>
          <p class="mt-4 text-lg text-slate-300">
            This is a discount off your final bill, not a fixed price. As the
            bill goes up, the discount grows with it — so a $300 repair
            automatically drops by $45.
          </p>
          <ul class="mt-6 space-y-3 text-white">
            {
              checklist.map((c) => (
                <li class="flex gap-3">
                  <span class="lp-check" aria-hidden="true">✓</span>
                  <span set:html={c} />
                </li>
              ))
            }
          </ul>
        </div>
      </div>
      <div class="mt-12 grid sm:grid-cols-2 gap-5">
        {
          features.map((f) => (
            <div class="lp-card reveal">
              <h3 class="lp-h3">{f.title}</h3>
              <p class="mt-2 text-slate-400 leading-relaxed">{f.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ WHY FIXING EARLY MATTERS ============ -->
  <section class="lp-section">
    <div class="lp-wrap">
      <div class="grid md:grid-cols-2 gap-10 lg:gap-16 items-center">
        <div>
          <h2 class="lp-h2">Why Waiting on a Repair Usually Costs More</h2>
          <p class="mt-4 text-lg text-slate-300">
            It's easy to put off a trip to the shop when you're worried about
            the cost. Taking up to $45 off now helps you handle it before one
            issue turns into two.
          </p>
          <div class="mt-8 space-y-6">
            {
              pains.map((p) => (
                <div class="flex gap-4 reveal">
                  <svg class="lp-line-icon mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d={p.icon} />
                  </svg>
                  <div>
                    <p class="text-xl font-medium text-white">{p.title}</p>
                    <p class="text-slate-400 mt-1">{p.body}</p>
                  </div>
                </div>
              ))
            }
          </div>
          <p class="mt-10 p-4 rounded-xl border border-[#0a79c8]/50 bg-[#0a79c8]/10 text-white text-center font-medium">
            <svg class="lp-line-icon inline-block align-text-bottom mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7 11V7a5 5 0 0 1 10 0v4m-11 0h12a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-6a2 2 0 0 1 2-2Zm6 4v2" />
            </svg>
            24-month / 24,000-mile warranty on most repairs — from our Elgin
            shop serving drivers since 2007.
          </p>
        </div>
        <div class="lp-photo">
          <img
            src="/images/services/Mechanic-inspecting-car-underneath.webp"
            alt="Technician using an inspection light under a vehicle on a shop lift"
            loading="lazy"
            width="600"
            height="422"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ============ TRUST STRIP ============ -->
  <section class="lp-section !py-6">
    <div class="lp-wrap grid sm:grid-cols-3 gap-5 text-center">
      <div class="lp-card reveal">
        <p class="lp-stat">{brand.ratingValue}<span class="lp-stars">★</span></p>
        <h3 class="text-white font-semibold mt-1">Google Rating</h3>
        <p class="text-sm text-slate-400">From {brand.reviewCount} reviews</p>
      </div>
      <div class="lp-card reveal">
        <p class="lp-stat">2007</p>
        <h3 class="text-white font-semibold mt-1">Serving Elgin Since</h3>
        <p class="text-sm text-slate-400">1303 Dundee Ave, Elgin</p>
      </div>
      <div class="lp-card reveal">
        <p class="lp-stat">24/24</p>
        <h3 class="text-white font-semibold mt-1">Month / Mile Warranty</h3>
        <p class="text-sm text-slate-400">On most repairs</p>
      </div>
    </div>
  </section>

  <!-- ============ ABOUT ============ -->
  <section class="lp-section">
    <div class="lp-wrap grid md:grid-cols-2 gap-10 lg:gap-16 items-center">
      <div>
        <h2 class="lp-h2">Your Dundee Ave Auto Shop Since 2007</h2>
        <p class="mt-4 text-slate-300 text-lg">
          Queens Auto Service has been at 1303 Dundee Ave in Elgin since 2007,
          handling repairs, maintenance, and diagnostics with a {brand.ratingValue}★
          rating across {brand.reviewCount} Google reviews. You book online with
          no payment up front, and the price is confirmed before any work starts.
        </p>
        <ul class="mt-6 space-y-3 text-white">
          <li class="flex gap-3"><span class="lp-check" aria-hidden="true">✓</span>Price confirmed before any repair work starts</li>
          <li class="flex gap-3"><span class="lp-check" aria-hidden="true">✓</span>24-month / 24,000-mile warranty on most repairs</li>
          <li class="flex gap-3"><span class="lp-check" aria-hidden="true">✓</span>Open Mon–Fri 7:30 AM–6 PM · Sat 7:30 AM–4 PM</li>
        </ul>
      </div>
      <!-- real shop photos: the storefront, techs in the bay, front counter -->
      <div class="ar-mosaic">
        <figure class="ar-mosaic-shop">
          <img
            src="/images/shop/Queens-Auto-Services-Front-Shot.webp"
            alt="Queens Auto Service storefront at 1303 Dundee Ave, Elgin, IL"
            loading="lazy"
            width="1360"
            height="856"
          />
          <figcaption class="ar-mosaic-tag">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z" /></svg>
            1303 Dundee Ave, Elgin
          </figcaption>
        </figure>
        <img
          class="ar-mosaic-work"
          src="/images/services/Queens-Auto-Auto-Repair-002.webp"
          alt="Queens Auto technicians working on a car raised on a lift inside the Elgin shop"
          loading="lazy"
          width="1536"
