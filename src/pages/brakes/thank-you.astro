---
import LandingLayout from "../../layouts/LandingLayout.astro";
import { mobileTiresBrand as brand } from "../../brands";

const title = "You're Booked! $369 Brake Service | Queens Auto Service";
const description =
  "Your brake service appointment at Queens Auto Service in Elgin, IL is confirmed.";

const phoneDigits = brand.phone.replace(/\D/g, "");

const bonuses = [
  "FREE Tire Rotation",
  "FREE Vehicle Safety Inspection",
  "FREE Brake Fluid Check & Top-Off",
  "50% OFF Oil Change",
];
---

<LandingLayout title={title} description={description} brand={brand} noindex>
  <script
    src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.2/dist/confetti.browser.min.js"
    is:inline></script>

  <div class="ty-wrap">
    <div class="ty-inner">
      <!-- Success icon -->
      <div class="ty-icon" aria-hidden="true">
        <svg
          class="w-12 h-12"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="3"
          stroke-linecap="round"
          stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg
        >
      </div>

      <h1 class="ty-h1">
        You're Booked, <span id="user-name" class="ty-grad">Guest</span>!
      </h1>
      <p class="mt-5 text-xl text-slate-300 max-w-2xl mx-auto leading-relaxed">
        Your <strong class="text-white">$369 Brake Service</strong> spot is
        saved. We've sent a confirmation to your email and a text reminder to
        your phone.
      </p>

      <!-- Coupon (shown only when the webhook returned a code) -->
      <div id="coupon-container" class="ty-coupon hidden">
        <p class="text-lg text-slate-300">Your savings code is:</p>
        <div class="flex items-center justify-center gap-4 mt-3">
          <p id="coupon-code-display" class="ty-code"></p>
          <button
            id="copy-coupon-btn"
            type="button"
            class="ty-copy"
            aria-label="Copy coupon code"
          >
            <svg
              class="w-5 h-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              ><rect width="8" height="4" x="8" y="2" rx="1" ry="1"></rect><path
                d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"
              ></path></svg
            >
          </button>
        </div>
        <p
          id="copy-feedback"
          class="text-sm font-bold text-green-400 h-5 mt-3 transition-opacity opacity-0"
          role="status"
        >
          Copied to clipboard!
        </p>
      </div>

      <!-- Personal audio message (shown only when the webhook returned one) -->
      <div class="mt-10">
        <button id="play-audio-btn" type="button" style="display: none;" class="ty-audio lp-btn">
          <span id="play-audio-text">Play a special message</span>
        </button>
      </div>

      <p id="vehicle-info" class="mt-4 text-lg text-slate-400 italic"></p>

      <!-- Summary -->
      <div class="ty-card text-left max-w-md mx-auto my-10 space-y-5">
        <div class="ty-row">
          <p class="ty-label">Service</p>
          <p class="font-bold text-white">$369 Brake Service (Pads &amp; Rotors)</p>
        </div>
        <div class="ty-row">
          <p class="ty-label">Date &amp; Time</p>
          <p id="summary-datetime" class="font-bold text-white">Pending confirmation</p>
        </div>
        <div>
          <p class="ty-label">Location</p>
          <p class="font-bold text-white">Queens Auto — Elgin</p>
          <p class="text-sm text-slate-400">{brand.address}</p>
        </div>
      </div>

      <!-- What's included -->
      <div class="ty-card text-left">
        <h2 class="ty-h2">What's Included With Your Visit</h2>
        <ul class="mt-6 grid sm:grid-cols-2 gap-x-8 gap-y-3 text-slate-200">
          <li class="flex gap-3">
            <span class="ty-check" aria-hidden="true">✓</span>$369 brake pads &amp; rotors
          </li>
          {
            bonuses.map((b) => (
              <li class="flex gap-3">
                <span class="ty-check" aria-hidden="true">✓</span>{b}
              </li>
            ))
          }
          <li class="flex gap-3 sm:col-span-2">
            <span class="ty-check" aria-hidden="true">✓</span>24-month /
            24,000-mile warranty on brake repairs
          </li>
        </ul>
      </div>

      <!-- What happens next -->
      <div class="ty-card text-left mt-8">
        <h2 class="ty-h2">What Happens Next?</h2>
        <ol class="mt-6 space-y-5">
          <li class="flex gap-4">
            <span class="ty-step">1</span>
            <p class="text-lg text-slate-300">
              <strong class="text-white">Check your text/email:</strong> We've
              sent a confirmation with your details.
            </p>
          </li>
          <li class="flex gap-4">
            <span class="ty-step">2</span>
            <p class="text-lg text-slate-300">
              <strong class="text-white">We'll call to confirm:</strong> A team
              member will call you shortly to confirm everything.
            </p>
          </li>
          <li class="flex gap-4">
            <span class="ty-step">3</span>
            <p class="text-lg text-slate-300">
              <strong class="text-white">Free brake inspection:</strong> We
              check your pads, rotors, calipers and lines first and walk you
              through what we find — no pressure.
            </p>
          </li>
          <li class="flex gap-4">
            <span class="ty-step">4</span>
            <p class="text-lg text-slate-300">
              <strong class="text-white">Drive away safer:</strong> Most brake
              jobs take under 90 minutes, finished with a road test.
            </p>
          </li>
        </ol>
        <p class="mt-6 text-xs text-slate-500 leading-relaxed">
          $369 applies per axle for most cars and light trucks. Excludes
          luxury/performance models, heavy-duty trucks and vehicles requiring
          specialized or ceramic parts. Price excludes taxes, shop supplies and
          additional parts or labor required for unforeseen issues (quoted
          separately).
        </p>
      </div>

      <!-- Help / directions -->
      <div class="grid md:grid-cols-2 gap-6 mt-8 text-left">
        <div class="ty-card">
          <h3 class="ty-h3">Need to Reschedule?</h3>
          <p class="text-slate-400 mt-3 mb-6">
            No problem. Give us a call and we'll find a better time for you.
          </p>
          <a href={`tel:${phoneDigits}`} class="lp-btn">{brand.phone}</a>
        </div>
        <div class="ty-card">
          <h3 class="ty-h3">Where to Find Us</h3>
          <p class="text-slate-400 mt-3 mb-6">{brand.address}</p>
          <a
            href={brand.googleMapsUrl}
            target="_blank"
            rel="noreferrer"
            class="lp-btn lp-btn-ghost">Get Directions</a
          >
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    const initBrakesThankYou = () => {
      const params = new URLSearchParams(window.location.search);
      const firstName = params.get("first_name") || "Guest";
      const audioUrl = sessionStorage.getItem("customAudioUrl");
      const couponCode = sessionStorage.getItem("userCouponCode");
      const date = params.get("date");
      const time = params.get("time");
      const carYear = params.get("carYear");
      const carMake = params.get("carMake");
      const carModel = params.get("carModel");

      // --- GTM conversion event (same shape as the standard thank-you page) ---
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        event: "purchase",
        ecommerce: {
          transaction_id: `txn_${Date.now()}`,
          value: 100.0,
          currency: "USD",
          items: [
            {
              item_name: params.get("symptom") || "Brakes",
              item_id: "REPAIR_SERVICE_LEAD",
              price: "100.00",
              quantity: "1",
            },
          ],
        },
        user_data: {
          email: params.get("email"),
          phone_number: params.get("phone"),
          address: {
            first_name: firstName,
            last_name: params.get("last_name") || "",
          },
        },
      });

      const nameEl = document.getElementById("user-name");
      if (nameEl) nameEl.textContent = firstName;

      // --- Coupon ---
      const couponBox = document.getElementById("coupon-container");
      const couponDisplay = document.getElementById("coupon-code-display");
      const copyBtn = document.getElementById("copy-coupon-btn");
      const copyFeedback = document.getElementById("copy-feedback");
      if (couponCode && couponBox && couponDisplay) {
        couponDisplay.textContent = couponCode;
        couponBox.classList.remove("hidden");
        if (copyBtn && copyFeedback) {
          copyBtn.onclick = async () => {
            try {
              await navigator.clipboard.writeText(couponCode);
              copyFeedback.classList.remove("opacity-0");
              setTimeout(() => copyFeedback.classList.add("opacity-0"), 2000);
            } catch (err) {
              console.error("Failed to copy code: ", err);
            }
          };
        }
      }

      // --- Vehicle (built with textContent: values come from the URL) ---
      const vehicleEl = document.getElementById("vehicle-info");
      if (vehicleEl) {
        if (carYear && carMake && carModel) {
          vehicleEl.textContent = "";
          vehicleEl.append("Your ");
          const strong = document.createElement("strong");
          strong.className = "text-white";
          strong.textContent = `${carYear} ${carMake} ${carModel}`;
          vehicleEl.append(strong, " is all set for its brake service.");
        } else {
          vehicleEl.style.display = "none";
        }
      }

      // --- Date / time ---
      const dtEl = document.getElementById("summary-datetime");
      if (date && time && dtEl) {
        try {
          const formatted = new Intl.DateTimeFormat("en-US", {
            weekday: "long",
            year: "numeric",
            month: "long",
            day: "numeric",
          }).format(new Date(date + "T00:00:00"));
          dtEl.textContent = `${formatted} at ${time}`;
        } catch (e) {
          dtEl.textContent = `${date} at ${time}`;
        }
      }

      // --- Confetti + audio ---
      const celebrate = () => {
        if (typeof confetti !== "function") return;
        const colors = ["#22d3ee", "#3b82f6", "#ffffff", "#a78bfa"];
        confetti({ particleCount: 150, spread: 80, origin: { y: 0.6 }, colors });
        setTimeout(() => confetti({ particleCount: 75, angle: 60, spread: 60, origin: { x: 0 }, colors }), 250);
        setTimeout(() => confetti({ particleCount: 75, angle: 120, spread: 60, origin: { x: 1 }, colors }), 400);
      };

      const playBtn = document.getElementById("play-audio-btn");
      const playText = document.getElementById("play-audio-text");
      if (audioUrl && playBtn) {
        playBtn.style.display = "inline-flex";
        if (firstName !== "Guest" && playText) playText.textContent = `Message for ${firstName}`;
        playBtn.onclick = () => {
          if (playBtn.disabled) return;
          celebrate();
          const audio = new Audio(audioUrl);
          audio.play().catch((e) => console.error("Audio play failed:", e));
          playBtn.disabled = true;
          if (playText) playText.textContent = "Playing...";
          audio.addEventListener("ended", () => {
            if (playText) playText.textContent = "Play Message Again";
            playBtn.disabled = false;
          });
        };
      }

      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        setTimeout(celebrate, 500);
      }
    };

    document.addEventListener("astro:page-load", initBrakesThankYou);
  </script>
</LandingLayout>

<style is:global>
  .ty-wrap {
    padding: 4rem 1.25rem 6rem;
    background: radial-gradient(ellipse 70% 40% at 50% 0%, rgba(10, 121, 200, 0.25), transparent 70%);
  }
  .ty-inner {
    max-width: 52rem;
    margin-inline: auto;
    text-align: center;
  }
  .ty-icon {
    width: 6rem;
    height: 6rem;
    margin: 0 auto 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    color: #4ade80;
    background: rgba(34, 197, 94, 0.1);
    border: 2px solid #22c55e;
  }
  .ty-h1,
  .ty-h2,
  .ty-h3 {
    font-family: var(--font-display);
    color: #fff;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    font-weight: 800;
    line-height: 1.05;
  }
  .ty-h1 {
    font-size: clamp(2.5rem, 7vw, 4.5rem);
  }
  .ty-h2 {
    font-size: clamp(1.75rem, 4vw, 2.25rem);
  }
  .ty-h3 {
    font-size: 1.5rem;
  }
  .ty-grad {
    background: linear-gradient(to right, #22d3ee, #3b82f6);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .ty-card {
    padding: 2rem;
    border-radius: 1.5rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.09);
  }
  .ty-row {
    padding-bottom: 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.09);
  }
  .ty-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #64748b;
    margin-bottom: 0.2rem;
  }
  .ty-coupon {
    max-width: 28rem;
    margin: 2rem auto 0;
    padding: 2rem;
    border-radius: 1.5rem;
    background: #0b1121;
    border: 2px dashed #22d3ee;
  }
  .ty-coupon.hidden {
    display: none;
  }
  .ty-code {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 8vw, 3.25rem);
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #67e8f9;
  }
  .ty-copy {
    padding: 0.65rem;
    border-radius: 0.75rem;
    color: #cbd5e1;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid transparent;
    cursor: pointer;
  }
  .ty-copy:hover {
    color: #fff;
    border-color: rgba(34, 211, 238, 0.4);
  }
  .ty-audio:disabled {
    opacity: 0.7;
    cursor: default;
  }
  .ty-check {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.4rem;
    height: 1.4rem;
    margin-top: 0.1rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 800;
    color: #04131f;
    background: #22d3ee;
  }
  .ty-step {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 9999px;
    font-weight: 800;
    color: #04131f;
    background: #22d3ee;
  }
</style>
