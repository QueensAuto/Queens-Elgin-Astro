---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import ServicesHome from "../components/ServicesHome.astro";
import ServiceCards from "../components/ServiceCards.astro";
import GSAPNewTires from "../components/GSAPNewTires.astro";
import ProcessSteps from "../components/ProcessSteps.astro";
import ReviewsVideo from "../components/ReviewsVideo.astro";
import WhyChooseUs from "../components/WhyChooseUs.astro";
import FinancingSection from "../components/FinancingSection.astro";
import MapEmbed from "../components/MapEmbed.astro";
import { mobileTiresBrand } from "../brands";
import reviews from "../data/reviews.json";
---

<BaseLayout
  brand={mobileTiresBrand}
  title="Queens Auto Service | Professional Auto Repair Shop in Elgin, IL"
  description="Expert auto repair and tire services in Elgin. From wheel alignments to engine diagnostics, we provide dealership-level care without the dealership pressure."
  reviewData={reviews}
>
  <!-- Hero video poster is above the fold on desktop only; on phones it sits
       below the fold, so don't spend early bandwidth on it there. -->
  <link
    rel="preload"
    as="image"
    href="/images/shop/Queens-Auto-Banner-001.webp"
    media="(min-width: 1024px)"
    slot="head"
  />

  <Hero brand={mobileTiresBrand} />
  <ServiceCards />
  <GSAPNewTires />
  <FinancingSection />
  <WhyChooseUs />
  <ProcessSteps />
  <ReviewsVideo />
  <ServicesHome brand={mobileTiresBrand} />
  <MapEmbed />
</BaseLayout>
