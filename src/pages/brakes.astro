---
import LandingLayout from "../layouts/LandingLayout.astro";
import BookingForm from "../components/BookingForm.astro";
import reviews from "../data/landing-reviews/brakes.json";
import { mobileTiresBrand as brand } from "../brands";

const title = "$369 Brake Service in Elgin, IL | Queens Auto Service";
const description =
  "Brake pads and rotors in Elgin, IL for $369 per axle, with $173 in bonuses and a 24-month / 24,000-mile warranty. Price confirmed before work starts. Book online in under a minute.";

const phoneDigits = brand.phone.replace(/\D/g, "");

const bonuses = [
  { text: "FREE Tire Rotation", value: "$29 Value" },
  { text: "FREE Vehicle Safety Inspection", value: "$79 Value" },
  { text: "FREE Brake Fluid Check & Top-Off", value: "$35 Value" },
  { text: "50% OFF Oil Change", value: "$30 Value" },
];

const promises = [
  {
    title: "Price Confirmed First",
    body: "You'll know the price before any work starts. Taxes and shop supplies are extra, and anything unexpected gets its own quote.",
    icon: "M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z",
  },
  {
    title: "Pads & Rotors, One Axle",
    body: "Standard brake pads and new rotors on both wheels of one axle (the front pair or the rear pair), installed, on most cars and light trucks.",
    icon: "M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z",
  },
  {
    title: "$173 in Bonuses",
    body: "A free tire rotation, safety inspection, and brake fluid check and top-off come with the job, plus 50% off an oil change.",
    icon: "M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7",
  },
  {
    title: "24/24 Warranty",
    body: "Your new pads and rotors are covered for 24 months or 24,000 miles, the same warranty we put on most repairs.",
    icon: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
  },
];

const warningIcon = "M10.3 4L2.5 18a2 2 0 0 0 1.7 3h15.6a2 2 0 0 0 1.7-3L13.7 4a2 2 0 0 0-3.4 0ZM12 9v4m0 4h.01";

const signs = [
  {
    icon: "M11 5 6 9H3v6h3l5 4V5Zm4 4a4 4 0 0 1 0 6m3-9a8 8 0 0 1 0 12",
    title: "A high squeal every time you stop",
    body: "Most pads have a small metal tab that squeals once the pad wears thin. A squeal that fades after a few stops on a wet morning is often just surface rust. One that sticks around is the tab.",
  },
  {
    icon: warningIcon,
    title: "Grinding or scraping",
    body: "That's usually metal on metal: the pad is worn through and its steel backing is cutting into the rotor. Don't wait on this one.",
  },
  {
    icon: "M7 3h6a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Zm3 8v7l5 3h4M8 6h4M8 8h4",
    title: "A pedal that feels soft or sinks lower",
    body: "If the pedal goes closer to the floor than it used to, it can mean low brake fluid, air in the lines or worn pads.",
  },
  {
    icon: "m3 16 13-13a1 1 0 0 1 1.4 0L21 6.6a1 1 0 0 1 0 1.4L8 21a1 1 0 0 1-1.4 0L3 17.4a1 1 0 0 1 0-1.4Zm10-10 2 2m-5 1 2 2m-5 1 2 2",
    title: "Shaking, pulling or longer stops",
    body: "A pulsing pedal or a steering wheel that shakes when you brake often points to worn rotors. Needing more room to stop is a sign too.",
  },
];

const features = [
  {
    title: "1. Book in under a minute",
    body: "Your contact and vehicle details, then a time that suits you. There's nothing to pay online.",
  },
  {
    title: "2. Bring it to Dundee Ave",
    body: "We're at 1303 Dundee Ave, open Mon–Fri 7:30 AM–6 PM and Sat 7:30 AM–4 PM.",
  },
  {
    title: "3. See the price before any work",
    body: "Your price is confirmed before work starts. If something beyond pads and rotors turns up, it's quoted separately.",
  },
  {
    title: "4. Leave covered, with your bonuses",
    body: "Your tire rotation, safety inspection and brake fluid check and top-off are free, and the brakes carry a 24-month / 24,000-mile warranty.",
  },
];

const checklist = [
  "<strong>$369 per axle</strong> on most cars and light trucks",
  "Price confirmed before any work starts",
  "Taxes and shop supplies listed separately",
  "Anything unexpected gets its own quote",
  "Financing available through Snap",
];

const pains = [
  {
    icon: warningIcon,
    title: "Stopping gets less predictable",
    body: "Once the pad material is gone, steel is pressing on the rotor. It stops worse, and the noise only gets louder.",
  },
  {
    icon: "M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-5 0a4 4 0 1 1-8 0 4 4 0 0 1 8 0ZM12 3v2m0 14v2M3 12h2m14 0h2",
    title: "The damage can spread past the rotor",
    body: "Drive on it long enough and the heat and metal can take out more than pads and rotors, like the calipers.",
  },
  {
    icon: "M14 4v16m4-12h-6a2 2 0 0 0 0 4h4a2 2 0 0 1 0 4h-6M3 8h4m-5 4h4m-3 4h4",
    title: "And that part isn't in the $369",
    body: "The flat price covers standard pads and rotors. Extra parts and labor are quoted separately, so catching it early keeps the bill closer to $369 per axle.",
  },
];

const cities = [
  "Elgin, IL",
  "South Elgin, IL",
  "Carpentersville, IL",
  "East Dundee, IL",
  "West Dundee, IL",
  "Gilberts, IL",
  "Algonquin, IL",
  "Huntley, IL",
  "Hoffman Estates, IL",
  "Barrington, IL",
];

const faqs = [
  {
    question: "What does $369 per axle cover?",
    answer:
      "Standard brake pads and new rotors on both wheels of one axle, either the front pair or the rear pair, on most cars and light trucks. Front and rear together is two axles. Taxes and shop supplies are extra, and any extra parts or labor for problems found along the way are quoted separately. Your price is confirmed before any work starts.",
  },
  {
    question: "Does my car qualify for the $369 brake price?",
    answer:
      `Most cars and light trucks do. Luxury and performance models, heavy-duty trucks, and vehicles that need ceramic or specialized parts don't, and the offer can't be combined with other discounts. Not sure about yours? Call ${brand.phone} before you book.`,
  },
  {
    question: "What are the free bonuses?",
    answer:
      "With the brake service you get a free tire rotation ($29 value), a free vehicle safety inspection ($79 value), a free brake fluid check and top-off ($35 value), and 50% off an oil change ($30 value). That's $173 in extras.",
  },
  {
    question: "How do I know if I need new brake pads and rotors?",
    answer:
      `Listen first. A squeal that won't go away usually means the pads' wear tab is touching the rotor. Grinding usually means the pad is worn through. A soft or sinking pedal, shaking when you brake, or a brake warning light are worth checking too. If you're not sure, call ${brand.phone} and tell us what you're hearing.`,
  },
  {
    question: "Can I keep driving on grinding brakes?",
    answer:
      "You can, but not for long. Grinding usually means metal on metal, which makes stopping less reliable and can damage parts beyond the pads and rotors, and those extra parts aren't in the $369 price. Book soon, and leave extra room to stop until then.",
  },
  {
    question: "Is there a warranty on brake service?",
    answer:
      "Yes. Your brake pads and rotors are covered by a 24-month / 24,000-mile warranty, the same coverage we put on most repairs.",
  },
  {
    question: "Do I have to pay when I book? Can I pay over time?",
    answer:
      "This is an online-exclusive offer, so book through this page to claim it. No payment is taken online. Booking takes under a minute, and your price is confirmed before any work starts. If you'd like to spread out the cost, financing is available through Snap.",
  },
];
---

<LandingLayout title={title} description={description} brand={brand} faqData={faqs}>
  <!-- ============ HERO ============ -->
  <section class="lp-hero">
    <div class="lp-wrap bk-hero-wrap pb-14 md:pb-20">
      <div class="bk-hero-grid">
      <div class="bk-intro">
        <p class="bk-symptom">
          <!-- a brake "recording": smooth running, then the grind -->
          <svg class="bk-symptom-wave" viewBox="0 0 60 20" aria-hidden="true" focusable="false">
            <path class="bk-wave-calm" pathLength="1" d="M1 10 C4 5.5 7 5.5 10 10 S16 14.5 19 10 S25 5.5 28 10" />
            <path class="bk-wave-grind" pathLength="1" d="M28 10 L30.2 4 L32.2 16 L34.6 2.5 L36.6 17.5 L39 3.5 L41 16.5 L43.4 5 L45.4 15 L47.8 6.5 L49.8 13.5 L52.2 8 L54.2 12 L56.6 9.2 L59 10" />
          </svg>
          <span>Squealing or grinding brakes?</span>
        </p>
        <h1 class="lp-h1 mt-6">
          New Brake Pads &amp; Rotors in Elgin — <span class="lp-grad">$369 Per Axle</span>
        </h1>
        <p class="bk-sub text-lg md:text-xl text-slate-300">
          Quality pads and rotors installed by our Elgin techs and backed by a
          24-month / 24,000-mile warranty — so you know the price before we
          start, and you won't pay for the same brakes twice.
        </p>
        <div class="bk-quick-offer">
          <p>$369 per axle · pads &amp; rotors · $173 in bonuses</p>
          <a href="#book" class="lp-btn">Book My $369 Brakes →</a>
          <p class="bk-reassure"><strong style="color:#22d3ee;font-weight:700">Online&nbsp;exclusive</strong> · No&nbsp;payment&nbsp;online · Book&nbsp;in&nbsp;under&nbsp;a&nbsp;minute · Price&nbsp;confirmed&nbsp;before&nbsp;work&nbsp;starts</p>
        </div>
      </div>

        <!-- Interactive 3D brake assembly (progressive enhancement: the photo is the fallback) -->
        <div class="bk-stage" id="brake-stage" data-ready="false">
          <img
            class="bk-poster"
            src="/images/brakes/Queens-Auto-Brake-Repair-Before-and-After-0001.webp"
            alt="Worn brake rotor before and new brake rotor after service"
            width="1080"
            height="783"
            fetchpriority="high"
          />
          <canvas
            class="bk-canvas"
            role="img"
            aria-label="Interactive 3D model of a disc brake: vented rotor, caliper, pads and hub"
          ></canvas>
          <div class="bk-labels" aria-hidden="true">
            <span class="bk-marker" data-part="rotor"><span class="bk-label">Vented rotor</span></span>
            <span class="bk-marker" data-part="pads"><span class="bk-label">Brake pads</span></span>
            <span class="bk-marker" data-part="caliper"><span class="bk-label">Caliper</span></span>
            <span class="bk-marker" data-part="hub"><span class="bk-label">Hub &amp; studs</span></span>
          </div>
          <button type="button" class="bk-toggle" id="brake-explode" aria-pressed="false">
            <span class="bk-toggle-off">Exploded view</span>
            <span class="bk-toggle-on">Assemble</span>
          </button>
          <p class="bk-hint" aria-hidden="true">Drag to rotate &nbsp;·&nbsp; Press &amp; hold to brake</p>
        </div>

        <div class="bk-offer">
          <ul class="bk-bonuses">
            <li class="flex items-start gap-3 text-white font-semibold">
              <span class="lp-check" aria-hidden="true">✓</span>
              $369 Per Axle — Quality Pads &amp; Rotors
            </li>
            {
              bonuses.map((b, i) => (
                <li class="flex items-start gap-3">
                  <span class="lp-plus" aria-hidden="true">+</span>
                  <span>
                    <strong class="text-white">Bonus {i + 1}:</strong> {b.text}{" "}
                    <span class="text-slate-400">({b.value})</span>
                  </span>
                </li>
              ))
            }
          </ul>

          <div class="bk-hero-actions flex flex-col sm:flex-row gap-3">
            <a href="#book" class="lp-btn">Book My $369 Brakes →</a>
            <a href={`tel:${phoneDigits}`} class="lp-btn lp-btn-ghost">Call {brand.phone}</a>
          </div>
          <p class="bk-reassure"><strong style="color:#22d3ee;font-weight:700">Online&nbsp;exclusive</strong> · No&nbsp;payment&nbsp;online · Book&nbsp;in&nbsp;under&nbsp;a&nbsp;minute · Price&nbsp;confirmed&nbsp;before&nbsp;work&nbsp;starts</p>

          <p class="mt-6 flex items-center gap-2 text-sm text-slate-400">
            <span class="lp-stars tracking-wide" aria-hidden="true">★★★★★</span>
            <span><strong class="text-white">{brand.ratingValue}</strong> on Google from {brand.reviewCount} reviews · Serving Elgin since 2007</span>
          </p>

          <details class="bk-restrictions mt-4 text-xs text-slate-400">
            <summary class="cursor-pointer inline">
              Restrictions apply. <span class="underline text-white font-semibold">See details</span>
            </summary>
            <p class="mt-2 max-w-md leading-relaxed">
              Online-exclusive offer: book through this page to claim it.
              Brake special of $369 applies per axle for most cars and light
              trucks and includes standard brake pads and rotors. Excludes
              luxury/performance models, heavy-duty trucks, and vehicles
              requiring specialized or ceramic parts. Cannot be combined with
              other discounts. Price excludes taxes, shop supplies, and any
              additional parts or labor required for unforeseen issues (quoted
              separately). See store for full details.
            </p>
          </details>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ PROMISE ============ -->
  <section class="lp-section">
    <div class="lp-wrap">
      <div class="lp-head reveal">
        <h2 class="lp-h2">What's in the $369 Brake Service</h2>
        <p>
          One price per axle for brake pads and rotors, four extras on top, and
          no guessing what you'll owe. Here's exactly what you're paying for.
        </p>
      </div>
      <div class="mt-12 grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {
          promises.map((p) => (
            <div class="lp-card text-center reveal">
              <div class="lp-icon mx-auto">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d={p.icon} />
                </svg>
              </div>
              <h3 class="lp-h3 mt-5">{p.title}</h3>
              <p class="mt-2 text-sm text-slate-400 leading-relaxed">{p.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ BOOKING FORM ============ -->
  <section id="book" class="lp-section lp-book">
    <div class="lp-wrap">
      <BookingForm
        fullDark
        presetService="Brakes"
        promoCode="brakes_369"
        step1TitleHighlight="Secure Your Spot"
        step1Description="Step 1 of 2 — Your contact and vehicle details."
        step3Description="Step 2 of 2 — Pick your preferred time."
      />
    </div>
  </section>

  <!-- ============ REVIEWS ============ -->
  <section class="lp-section" id="reviews">
    <div class="lp-wrap">
      <div class="lp-head reveal">
        <h2 class="lp-h2">What <span class="lp-grad">Elgin Drivers</span> Say</h2>
        <p>
          {brand.ratingValue} stars from {brand.reviewCount} Google reviews.
          A few of them, in their own words.
        </p>
      </div>
      <div class="mt-12 grid md:grid-cols-2 lg:grid-cols-3 gap-5">
        {
          reviews.map((r) => (
            <figure class="lp-card reveal flex flex-col">
              <div class="lp-stars" aria-label={`${r.stars} out of 5 stars`}>
                {"★".repeat(r.stars)}
              </div>
              <blockquote class="mt-3 text-slate-200 leading-relaxed grow">
                “{r.text}”
              </blockquote>
              <figcaption class="mt-5 pt-4 border-t border-white/10 text-sm">
                <span class="text-white font-semibold">{r.name === "Google reviewer" ? "Google review" : r.name}</span>
                <span class="text-slate-500"> · {r.date}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ WHEN TO REPLACE ============ -->
  <section class="lp-section">
    <div class="lp-wrap">
      <div class="lp-head reveal">
        <h2 class="lp-h2">Signs Your Brake Pads and Rotors Are Worn</h2>
        <p>
          Brakes rarely quit without warning. You'll usually hear it first,
          then feel it in the pedal.
        </p>
      </div>
      <div class="mt-12 grid md:grid-cols-2 gap-10 lg:gap-16 items-center">
        <div>
          <h3 class="lp-h3 mb-5">What you might be noticing</h3>
          <ul class="space-y-5">
            {
              signs.map((s) => (
                <li class="flex gap-4 reveal">
                  <svg class="lp-line-icon mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d={s.icon} />
                  </svg>
                  <div>
                    <strong class="text-white">{s.title}</strong>
                    <p class="text-slate-400 mt-0.5">{s.body}</p>
                  </div>
                </li>
              ))
            }
          </ul>
          <div class="mt-8">
            <h3 class="lp-h3">Sound familiar?</h3>
            <p class="mt-2 text-slate-300">
              Book a time online. The $369 covers pads and rotors on the axle
              that needs them, and you'll see the price before any work starts.
            </p>
            <a href="#book" class="lp-btn mt-5">Book $369 Brake Service →</a>
          </div>
        </div>
        <div class="lp-photo">
          <img
            src="/images/brakes/Worned-out-brake-pads-vs-New-pads.webp"
            alt="Worn-out brake pads compared with new brake pads"
            loading="lazy"
            width="2528"
            height="1696"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ============ EXPERT SERVICE ============ -->
  <section class="lp-section">
    <div class="lp-wrap">
      <div class="grid md:grid-cols-2 gap-10 lg:gap-16 items-center">
        <div class="lp-photo">
          <img
            src="/images/brakes/disc-brake-service-mechanic-elgin-il.webp"
            alt="Queens Auto mechanic servicing a disc brake in Elgin, IL"
            loading="lazy"
            width="1024"
            height="1024"
          />
        </div>
        <div>
          <h2 class="lp-h2">Brake Service in Elgin Without the Surprise Bill</h2>
          <p class="mt-4 text-lg text-slate-300">
            The worry with any brake job is the counter: you came in for one
            price and leave with another. Here's how pricing works on this one.
            Luxury and performance models, heavy-duty trucks, and ceramic or
            specialized parts aren't part of the $369, so
            call {brand.phone} if you're not sure about your car.
          </p>
          <ul class="mt-6 space-y-3 text-white">
            {
              checklist.map((c) => (
                <li class="flex gap-3">
                  <span class="lp-check" aria-hidden="true">✓</span>
                  <span set:html={c} />
                </li>
              ))
            }
          </ul>
        </div>
      </div>
      <div class="mt-12 grid sm:grid-cols-2 gap-5">
        {
          features.map((f) => (
            <div class="lp-card reveal">
              <h3 class="lp-h3">{f.title}</h3>
              <p class="mt-2 text-slate-400 leading-relaxed">{f.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ WHY IT MATTERS ============ -->
  <section class="lp-section">
    <div class="lp-wrap">
      <div class="grid md:grid-cols-2 gap-10 lg:gap-16 items-center">
        <div>
          <h2 class="lp-h2">What Happens If You Keep Driving on Grinding Brakes?</h2>
          <p class="mt-4 text-lg text-slate-300">
            A squeal is a warning. Grinding means the warning period is over.
          </p>
          <div class="mt-8 space-y-6">
            {
              pains.map((p) => (
                <div class="flex gap-4 reveal">
                  <svg class="lp-line-icon mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d={p.icon} />
                  </svg>
                  <div>
                    <p class="text-xl font-medium text-white">{p.title}</p>
                    <p class="text-slate-400 mt-1">{p.body}</p>
                  </div>
                </div>
              ))
            }
          </div>
          <p class="mt-10 p-4 rounded-xl border border-[#0a79c8]/50 bg-[#0a79c8]/10 text-white text-center font-medium">
            <svg class="lp-line-icon inline-block align-text-bottom mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7 11V7a5 5 0 0 1 10 0v4m-11 0h12a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-6a2 2 0 0 1 2-2Zm6 4v2" />
            </svg>
            Fix it now and your new pads and rotors are covered for 24 months
            or 24,000 miles.
          </p>
        </div>
        <div class="lp-photo">
          <img
            src="/images/brakes/damaged-brake-rotor-elgin-mechanic.webp"
            alt="Damaged, scored brake rotor"
            loading="lazy"
            width="1500"
            height="1500"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ============ TRUST STRIP ============ -->
  <section class="lp-section !py-6">
    <div class="lp-wrap grid sm:grid-cols-3 gap-5 text-center">
      <div class="lp-card reveal">
        <p class="lp-stat">{brand.ratingValue}<span class="lp-stars">★</span></p>
        <h3 class="text-white font-semibold mt-1">Google Rating</h3>
        <p class="text-sm text-slate-400">From {brand.reviewCount} reviews</p>
      </div>
      <div class="lp-card reveal">
        <p class="lp-stat">2007</p>
        <h3 class="text-white font-semibold mt-1">Serving Elgin Since</h3>
        <p class="text-sm text-slate-400">At 1303 Dundee Ave</p>
      </div>
      <div class="lp-card reveal">
        <p class="lp-stat">24/24</p>
        <h3 class="text-white font-semibold mt-1">Month / Mile Warranty</h3>
        <p class="text-sm text-slate-400">On most repairs, brakes included</p>
      </div>
    </div>
  </section>

  <!-- ============ ABOUT ============ -->
  <section class="lp-section">
    <div class="lp-wrap grid md:grid-cols-2 gap-10 lg:gap-16 items-center">
      <div>
        <h2 class="lp-h2">An Elgin Repair Shop Since 2007</h2>
        <p class="mt-4 text-slate-300 text-lg">
          Queens Auto Service has been fixing cars at 1303 Dundee Ave since
          2007. You don't have to take our word for the rest:
          {brand.reviewCount} drivers have reviewed us on Google, and
          we're at {brand.ratingValue} stars. Brakes, tires, oil changes and everyday repairs all happen
          under one roof.
        </p>
        <ul class="mt-6 space-y-3 text-white">
          <li class="flex gap-3"><span class="lp-check" aria-hidden="true">✓</span>Price confirmed before work starts</li>
          <li class="flex gap-3"><span class="lp-check" aria-hidden="true">✓</span>Open Monday to Saturday from 7:30 AM</li>
          <li class="flex gap-3"><span class="lp-check" aria-hidden="true">✓</span>24-month / 24,000-mile warranty on most repairs</li>
        </ul>
      </div>
      <!-- real shop photos: the storefront, a brake job in progress, the tire wall -->
      <div class="bk-mosaic">
        <figure class="bk-mosaic-shop">
          <img
