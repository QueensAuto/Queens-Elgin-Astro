  <script>
    // Lazy-load the 3D scene when the hero stage is near the viewport.
    let brakeDispose: (() => void) | null = null;
    let stickyObserver: IntersectionObserver | undefined;
    let revealObserver: IntersectionObserver | undefined;

    function initBrakeStage() {
      const stage = document.getElementById("brake-stage");
      if (!stage || stage.dataset.mounted) return;
      stage.dataset.mounted = "true";

      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const toggle = document.getElementById("brake-explode");

      // The display's own frame interval (30 Hz in Low Power Mode / Energy Saver),
      // sampled while the scene downloads so the quality governor can tell a
      // capped screen from a slow GPU.
      const measureRefresh = () =>
        new Promise<number>((resolve) => {
          const gaps: number[] = [];
          let prev = 0;
          const pick = () => (gaps.length ? gaps.sort((a, b) => a - b)[Math.floor(gaps.length / 4)] : 1000 / 60);
          const tick = (now: number) => {
            if (prev) gaps.push(now - prev);
            prev = now;
            if (gaps.length < 12) requestAnimationFrame(tick);
            else resolve(pick());
          };
          requestAnimationFrame(tick);
          setTimeout(() => resolve(pick()), 500);
        });

      const load = async () => {
        try {
          const refresh = measureRefresh();
          const { mountBrakeScene } = await import("../scripts/brake-scene");
          const handle = mountBrakeScene(stage, { reducedMotion: reduced, refreshMs: await refresh });
          if (!handle) return; // no WebGL → poster stays
          brakeDispose = handle.dispose;
          toggle?.addEventListener("click", () => {
            const on = toggle.getAttribute("aria-pressed") !== "true";
            toggle.setAttribute("aria-pressed", String(on));
            handle.setExploded(on);
          });
        } catch (err) {
          console.warn("3D brake scene unavailable:", err);
        }
      };

      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            if (entries[0].isIntersecting) {
              io.disconnect();
              load();
            }
          },
          { rootMargin: "300px" },
        );
        io.observe(stage);
      } else {
        load();
      }
    }

    function initStickyOffer() {
      const sticky = document.querySelector<HTMLElement>(".lp-sticky");
      if (!sticky || !("IntersectionObserver" in window)) return;

      const visible = new Set<Element>();
      stickyObserver = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) visible.add(entry.target);
          else visible.delete(entry.target);
        }
        const hidden = visible.size > 0;
        sticky.classList.toggle("is-hidden", hidden);
        sticky.inert = hidden;
      });
      document.querySelectorAll("#book, .bk-quick-offer .lp-btn, .bk-hero-actions").forEach((el) => {
        stickyObserver?.observe(el);
      });
    }

    function initReveals() {
      const reveals = document.querySelectorAll(".lp-section .reveal");
      if (!reveals.length || !("IntersectionObserver" in window)) return;
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

      revealObserver = new IntersectionObserver((entries, observer) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add("is-revealed");
          observer.unobserve(entry.target);
        }
      });
      reveals.forEach((el) => revealObserver?.observe(el));
    }

    document.addEventListener("astro:page-load", () => {
      initBrakeStage();
      initStickyOffer();
      initReveals();
    });
    document.addEventListener("astro:before-swap", () => {
      brakeDispose?.();
      brakeDispose = null;
      stickyObserver?.disconnect();
      stickyObserver = undefined;
      revealObserver?.disconnect();
      revealObserver = undefined;
    });
  </script>
