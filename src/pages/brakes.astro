---
import LandingLayout from "../layouts/LandingLayout.astro";
import BookingForm from "../components/BookingForm.astro";
import reviews from "../data/reviews.json";
import { mobileTiresBrand as brand } from "../brands";

const title = "$369 Brake Service in Elgin, IL | Queens Auto Service";
const description =
  "Professional brake pad and rotor service in Elgin, IL for $369 per axle with a 24-month / 24,000-mile warranty. Free inspection, upfront pricing. Book online in under a minute.";

const phoneDigits = brand.phone.replace(/\D/g, "");

const bonuses = [
  { text: "FREE Tire Rotation", value: "$29 Value" },
  { text: "FREE Vehicle Safety Inspection", value: "$79 Value" },
  { text: "FREE Brake Fluid Check & Top-Off", value: "$35 Value" },
  { text: "50% OFF Oil Change", value: "$30 Value" },
];

const promises = [
  {
    title: "Upfront Pricing",
    body: "The price we quote is the price you pay. No surprises, no hidden fees, and no upselling. Just honest work at a fair price.",
    icon: "M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z",
  },
  {
    title: "Quality Parts",
    body: "We use only high-quality brake pads and rotors that meet or exceed manufacturer specifications for safety and longevity.",
    icon: "M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z",
  },
  {
    title: "Expert Technicians",
    body: "Our experienced technicians are brake system specialists, so your service is done right the first time, every time.",
    icon: "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z",
  },
  {
    title: "24/24 Warranty",
    body: "Drive with confidence knowing your brake service is covered by our 24-month / 24,000-mile nationwide warranty.",
    icon: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
  },
];

const warningIcon = "M10.3 4L2.5 18a2 2 0 0 0 1.7 3h15.6a2 2 0 0 0 1.7-3L13.7 4a2 2 0 0 0-3.4 0ZM12 9v4m0 4h.01";

const signs = [
  {
    icon: "M11 5 6 9H3v6h3l5 4V5Zm4 4a4 4 0 0 1 0 6m3-9a8 8 0 0 1 0 12",
    title: "Squealing or grinding noise",
    body: "A high-pitched squeal comes from a metal wear indicator on the pad telling you it's time for a replacement.",
  },
  {
    icon: "M7 3h6a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Zm3 8v7l5 3h4M8 6h4M8 8h4",
    title: "Soft or spongy pedal",
    body: "If your brake pedal goes further to the floor than usual, it could mean low fluid or worn pads.",
  },
  {
    icon: "m3 16 13-13a1 1 0 0 1 1.4 0L21 6.6a1 1 0 0 1 0 1.4L8 21a1 1 0 0 1-1.4 0L3 17.4a1 1 0 0 1 0-1.4Zm10-10 2 2m-5 1 2 2m-5 1 2 2",
    title: "Longer stopping distance",
    body: "If your car is taking longer to stop, your brakes are losing their effectiveness.",
  },
  {
    icon: warningIcon,
    title: "Dashboard warning light",
    body: "Many modern vehicles have a sensor that lights up when pads are low.",
  },
];

const features = [
  {
    title: "Comprehensive Vehicle Inspection",
    body: "Before we begin, we inspect your whole braking system — rotors, calipers, hoses and sensors — to catch underlying issues that could affect performance or safety.",
  },
  {
    title: "State-of-the-Art Technology",
    body: "High-precision diagnostic tools check pad thickness, rotor condition and hydraulic function, so repairs meet factory specifications.",
  },
  {
    title: "Your Safety Is Our Top Priority",
    body: "A brake repair isn't complete without the bigger picture. We inspect critical components like ABS sensors and brake lines so your car stops safely every time.",
  },
  {
    title: "Final Road Test",
    body: "We finish with a complimentary road test to confirm smooth braking, even pedal feel and proper response in real-world conditions.",
  },
];

const checklist = [
  "State-of-the-art equipment",
  "Free brake inspection included",
  "<strong>2-Year / 24,000-Mile Warranty on brake repairs</strong>",
  "Financing available through Snap",
  "Valid on most vehicles",
];

const pains = [
  {
    icon: "M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-5 0a4 4 0 1 1-8 0 4 4 0 0 1 8 0ZM12 3v2m0 14v2M3 12h2m14 0h2",
    title: "Tires & Rotors Wear Faster",
    body: "Worn or warped rotors cause uneven braking and excess tire wear — you could lose $400–$800 in replacements and repairs.",
  },
  {
    icon: warningIcon,
    title: "Brakes That Squeal = Less Control",
    body: "A squealing or grinding noise means your pads are worn. Ignore it and you risk losing stopping power in an emergency.",
  },
  {
    icon: "M14 4v16m4-12h-6a2 2 0 0 0 0 4h4a2 2 0 0 1 0 4h-6M3 8h4m-5 4h4m-3 4h4",
    title: "You'll Pay More Later",
    body: "Delaying brake service can damage rotors, calipers and ABS sensors — turning a $369-per-axle brake service into a $1,000+ repair.",
  },
];

const cities = [
  "Elgin, IL",
  "South Elgin, IL",
  "Carpentersville, IL",
  "East Dundee, IL",
  "West Dundee, IL",
  "Gilberts, IL",
  "Algonquin, IL",
  "Huntley, IL",
  "Hoffman Estates, IL",
  "Barrington, IL",
];

const faqs = [
  {
    question: "How do I know if I need new brake pads?",
    answer:
      "If you hear squealing or grinding, your pads are down to the metal wear indicator — which means you likely have only a week or two before rotor damage starts. That can turn a $369-per-axle brake service into an $800+ repair. We'll inspect them free and tell you exactly where you stand — no pressure, just honest answers.",
  },
  {
    question: "How long do brake repairs take?",
    answer:
      "Most brake jobs are done in under 90 minutes. If we're replacing rotors or doing anything more in-depth, we'll tell you and give you a realistic time estimate upfront. You can even book a free inspection today — it takes less than a minute.",
  },
  {
    question: "How much does a brake repair cost?",
    answer:
      "Our brake service is $369 per axle for most vehicles. Cost may vary slightly depending on parts or vehicle type, but we always give you upfront pricing. If you need a little flexibility, we also offer financing through Snap Financing.",
  },
  {
    question: "Do you offer a warranty on brake repairs?",
    answer:
      "Yes — brake repairs are backed by a 24-month / 24,000-mile warranty. For other mechanical services, the same strong warranty applies. We stand behind every repair we do.",
  },
  {
    question: "Can I drive with worn brakes?",
    answer:
      "Technically yes. Safely? Not really. Worn brakes mean reduced stopping power — and that's dangerous. The longer you wait, the more damage you risk to rotors, sensors and even tires. Let's fix it before it costs more — or worse.",
  },
  {
    question: "What vehicles do you service?",
    answer:
      "We work on most cars, SUVs and light trucks — foreign or domestic. Not sure if we can help? Just ask. Chances are, we've worked on one just like yours.",
  },
  {
    question: "What if I'm not sure it's my brakes?",
    answer:
      "No problem. Come by for a free check. Whether it's your pads, rotors, suspension or something else entirely, we'll diagnose it and walk you through next steps — pressure-free.",
  },
  {
    question: "Do I need to replace all 4 brakes at once?",
    answer:
      "Not always. If the rear brakes are still in good shape, we'll leave them alone. We only recommend replacing what's necessary — nothing more, nothing less.",
  },
  {
    question: "Why is my car making a grinding noise when I stop?",
    answer:
      "That usually means your brake pads are completely worn and metal is grinding against your rotors, which can lead to expensive damage fast. Best to get it checked right away.",
  },
];
---

<LandingLayout title={title} description={description} brand={brand} faqData={faqs} reviewData={reviews}>
  <!-- ============ HERO ============ -->
  <section class="lp-hero">
    <div class="lp-wrap bk-hero-wrap pb-14 md:pb-20">
      <div class="bk-hero-grid">
      <div class="bk-intro">
        <span class="lp-pill">Professional Brake Service · Elgin, IL</span>
        <h1 class="lp-h1 mt-6">
          <span class="lp-grad">Stop Safer Today:</span> $369 Complete Brake Service
        </h1>
        <p class="bk-sub text-lg md:text-xl text-slate-300">
          Your brakes are your family's last line of defense. Get professional
          service with quality parts, expert installation and a 24-month
          warranty — all for $369 per axle. Plus $173 in bonuses to keep you
          protected on the road.
        </p>
        <div class="bk-quick-offer">
          <p>$369 per axle · pads &amp; rotors · $173 in bonuses</p>
          <a href="#book" class="lp-btn">Claim My $369 Brakes →</a>
        </div>
      </div>

        <!-- Interactive 3D brake assembly (progressive enhancement: the photo is the fallback) -->
        <div class="bk-stage" id="brake-stage" data-ready="false">
          <img
            class="bk-poster"
            src="/images/brakes/Queens-Auto-Brake-Repair-Before-and-After-0001.webp"
            alt="Worn brake rotor before and new brake rotor after service"
            width="1080"
            height="783"
            fetchpriority="high"
          />
          <canvas
            class="bk-canvas"
            role="img"
            aria-label="Interactive 3D model of a disc brake: vented rotor, caliper, pads and hub"
          ></canvas>
          <div class="bk-labels" aria-hidden="true">
            <span class="bk-marker" data-part="rotor"><span class="bk-label">Vented rotor</span></span>
            <span class="bk-marker" data-part="pads"><span class="bk-label">Brake pads</span></span>
            <span class="bk-marker" data-part="caliper"><span class="bk-label">Caliper</span></span>
            <span class="bk-marker" data-part="hub"><span class="bk-label">Hub &amp; studs</span></span>
          </div>
          <button type="button" class="bk-toggle" id="brake-explode" aria-pressed="false">
            <span class="bk-toggle-off">Exploded view</span>
            <span class="bk-toggle-on">Assemble</span>
          </button>
          <p class="bk-hint" aria-hidden="true">Drag to rotate &nbsp;·&nbsp; Press &amp; hold to brake</p>
        </div>

        <div class="bk-offer">
          <ul class="bk-bonuses">
            <li class="flex items-start gap-3 text-white font-semibold">
              <span class="lp-check" aria-hidden="true">✓</span>
              $369 Per Axle — Quality Pads &amp; Rotors
            </li>
            {
              bonuses.map((b, i) => (
                <li class="flex items-start gap-3">
                  <span class="lp-plus" aria-hidden="true">+</span>
                  <span>
                    <strong class="text-white">Bonus {i + 1}:</strong> {b.text}{" "}
                    <span class="text-slate-400">({b.value})</span>
                  </span>
                </li>
              ))
            }
          </ul>

          <div class="bk-hero-actions flex flex-col sm:flex-row gap-3">
            <a href="#book" class="lp-btn">Claim My $369 Brakes →</a>
            <a href={`tel:${phoneDigits}`} class="lp-btn lp-btn-ghost">Call {brand.phone}</a>
          </div>

          <p class="mt-6 flex items-center gap-2 text-sm text-slate-400">
            <span class="lp-stars tracking-wide" aria-hidden="true">★★★★★</span>
            <span><strong class="text-white">{brand.ratingValue}</strong> on Google from {brand.reviewCount}+ Elgin-area drivers</span>
          </p>

          <details class="bk-restrictions mt-4 text-xs text-slate-400">
            <summary class="cursor-pointer inline">
              Restrictions apply. <span class="underline text-white font-semibold">See details</span>
            </summary>
            <p class="mt-2 max-w-md leading-relaxed">
              Brake special of $369 applies per axle for most cars and light
              trucks and includes standard brake pads and rotors. Excludes
              luxury/performance models, heavy-duty trucks, and vehicles
              requiring specialized or ceramic parts. Cannot be combined with
              other discounts. Price excludes taxes, shop supplies, and any
              additional parts or labor required for unforeseen issues (quoted
              separately). See store for full details.
            </p>
          </details>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ PROMISE ============ -->
  <section class="lp-section">
    <div class="lp-wrap">
      <div class="lp-head reveal">
        <h2 class="lp-h2">Our Iron-Clad Brake Service Guarantee</h2>
        <p>
          We stand behind our work with a promise of quality, transparency and
          peace of mind. Every brake service is backed by these four
          commitments.
        </p>
      </div>
      <div class="mt-12 grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {
          promises.map((p) => (
            <div class="lp-card text-center reveal">
              <div class="lp-icon mx-auto">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d={p.icon} />
                </svg>
              </div>
              <h3 class="lp-h3 mt-5">{p.title}</h3>
              <p class="mt-2 text-sm text-slate-400 leading-relaxed">{p.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ BOOKING FORM ============ -->
  <section id="book" class="lp-section lp-book">
    <div class="lp-wrap">
      <BookingForm
        fullDark
        presetService="Brakes"
        promoCode="brakes_369"
        thankYouUrl="/brakes/thank-you"
        step1TitleHighlight="Secure Your Spot"
        step1Description="Step 1 of 2 — Your contact and vehicle details."
        step3Description="Step 2 of 2 — Pick your preferred time."
      />
    </div>
  </section>

  <!-- ============ REVIEWS ============ -->
  <section class="lp-section" id="reviews">
    <div class="lp-wrap">
      <div class="lp-head reveal">
        <h2 class="lp-h2">Trusted by <span class="lp-grad">Elgin Drivers</span></h2>
        <p>
          Elgin-area drivers count on Queens Auto for fast, affordable and
          reliable service. Here's what they say on Google.
        </p>
      </div>
      <div class="mt-12 grid md:grid-cols-2 lg:grid-cols-3 gap-5">
        {
          reviews.map((r) => (
            <figure class="lp-card reveal flex flex-col">
              <div class="lp-stars" aria-label={`${r.stars} out of 5 stars`}>
                {"★".repeat(r.stars)}
              </div>
              <blockquote class="mt-3 text-slate-200 leading-relaxed grow">
                “{r.text}”
              </blockquote>
              <figcaption class="mt-5 pt-4 border-t border-white/10 text-sm">
                <span class="text-white font-semibold">{r.name}</span>
                <span class="text-slate-500"> · {r.source}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ WHEN TO REPLACE ============ -->
  <section class="lp-section">
    <div class="lp-wrap">
      <div class="lp-head reveal">
        <h2 class="lp-h2">When to Replace Your Brake Pads</h2>
        <p>
          Know the warning signs of worn brake pads to avoid costly repairs and
          stay safe on the road.
        </p>
      </div>
      <div class="mt-12 grid md:grid-cols-2 gap-10 lg:gap-16 items-center">
        <div>
          <h3 class="lp-h3 mb-5">Watch for these signs</h3>
          <ul class="space-y-5">
            {
              signs.map((s) => (
                <li class="flex gap-4 reveal">
                  <svg class="lp-line-icon mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d={s.icon} />
                  </svg>
                  <div>
                    <strong class="text-white">{s.title}</strong>
                    <p class="text-slate-400 mt-0.5">{s.body}</p>
                  </div>
                </li>
              ))
            }
          </ul>
          <div class="mt-8">
            <h3 class="lp-h3">Don't wait — act now</h3>
            <p class="mt-2 text-slate-300">
              Delaying replacement risks damaging your expensive rotors and
              creating a safety hazard.
            </p>
            <a href="#book" class="lp-btn mt-5">Book $369 Brake Service →</a>
          </div>
        </div>
        <div class="lp-photo">
          <img
            src="/images/brakes/Worned-out-brake-pads-vs-New-pads.webp"
            alt="Worn-out brake pads compared with new brake pads"
            loading="lazy"
            width="2528"
            height="1696"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ============ EXPERT SERVICE ============ -->
  <section class="lp-section">
    <div class="lp-wrap">
      <div class="grid md:grid-cols-2 gap-10 lg:gap-16 items-center">
        <div class="lp-photo">
          <img
            src="/images/brakes/disc-brake-service-mechanic-elgin-il.webp"
            alt="Queens Auto mechanic servicing a disc brake in Elgin, IL"
            loading="lazy"
            width="1024"
            height="1024"
          />
        </div>
        <div>
          <h2 class="lp-h2">Expert Brake Repair, Done with Precision.</h2>
          <p class="mt-4 text-lg text-slate-300">
            At our Elgin shop we don't just fix brakes — we restore confidence.
            With years of hands-on experience and advanced diagnostics, we make
            sure your braking system performs safely and reliably. Here's
            what's included:
          </p>
          <ul class="mt-6 space-y-3 text-white">
            {
              checklist.map((c) => (
                <li class="flex gap-3">
                  <span class="lp-check" aria-hidden="true">✓</span>
                  <span set:html={c} />
                </li>
              ))
            }
          </ul>
        </div>
      </div>
      <div class="mt-12 grid sm:grid-cols-2 gap-5">
        {
          features.map((f) => (
            <div class="lp-card reveal">
              <h3 class="lp-h3">{f.title}</h3>
              <p class="mt-2 text-slate-400 leading-relaxed">{f.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ WHY IT MATTERS ============ -->
  <section class="lp-section">
    <div class="lp-wrap">
      <div class="grid md:grid-cols-2 gap-10 lg:gap-16 items-center">
        <div>
          <h2 class="lp-h2">What Happens When You Ignore That Grinding Noise?</h2>
          <p class="mt-4 text-lg text-slate-300">
            Here's why Elgin drivers fix their brakes before they fail.
          </p>
          <div class="mt-8 space-y-6">
            {
              pains.map((p) => (
                <div class="flex gap-4 reveal">
                  <svg class="lp-line-icon mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d={p.icon} />
                  </svg>
                  <div>
                    <p class="text-xl font-medium text-white">{p.title}</p>
                    <p class="text-slate-400 mt-1">{p.body}</p>
                  </div>
                </div>
              ))
            }
          </div>
          <p class="mt-10 p-4 rounded-xl border border-[#0a79c8]/50 bg-[#0a79c8]/10 text-white text-center font-medium">
            <svg class="lp-line-icon inline-block align-text-bottom mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7 11V7a5 5 0 0 1 10 0v4m-11 0h12a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-6a2 2 0 0 1 2-2Zm6 4v2" />
            </svg>
            Backed by the ProVantage Nationwide Warranty — 24 months or
            24,000 miles of protection at 30,000+ repair shops across the U.S.
            and Canada
          </p>
        </div>
        <div class="lp-photo">
          <img
            src="/images/brakes/damaged-brake-rotor-elgin-mechanic.webp"
            alt="Damaged, scored brake rotor"
            loading="lazy"
            width="1500"
            height="1500"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ============ TRUST STRIP ============ -->
  <section class="lp-section !py-6">
    <div class="lp-wrap grid sm:grid-cols-3 gap-5 text-center">
      <div class="lp-card reveal">
        <p class="lp-stat">{brand.ratingValue}<span class="lp-stars">★</span></p>
        <h3 class="text-white font-semibold mt-1">Google Rating</h3>
        <p class="text-sm text-slate-400">From {brand.reviewCount}+ reviews</p>
      </div>
      <div class="lp-card reveal">
        <p class="lp-stat">2007</p>
        <h3 class="text-white font-semibold mt-1">Serving Elgin Since</h3>
        <p class="text-sm text-slate-400">Family-owned &amp; local</p>
      </div>
      <div class="lp-card reveal">
        <p class="lp-stat">24/24</p>
        <h3 class="text-white font-semibold mt-1">Month / Mile Warranty</h3>
        <p class="text-sm text-slate-400">Peace of mind guaranteed</p>
      </div>
    </div>
  </section>

  <!-- ============ ABOUT ============ -->
  <section class="lp-section">
    <div class="lp-wrap grid md:grid-cols-2 gap-10 lg:gap-16 items-center">
      <div>
        <h2 class="lp-h2">Elgin's Trusted Neighborhood Auto Repair Shop</h2>
        <p class="mt-4 text-slate-300 text-lg">
          Queens Auto Service is proud to serve Elgin with reliable, honest car
          care. We treat every customer like a neighbor and every vehicle like
          our own. Whether you're here for brake work, routine maintenance or
          an unexpected repair, we've got your back with fair prices and real
          solutions.
        </p>
        <ul class="mt-6 space-y-3 text-white">
          <li class="flex gap-3"><span class="lp-check" aria-hidden="true">✓</span>Honest &amp; transparent pricing</li>
          <li class="flex gap-3"><span class="lp-check" aria-hidden="true">✓</span>Experienced, professional technicians</li>
          <li class="flex gap-3"><span class="lp-check" aria-hidden="true">✓</span>24-month / 24,000-mile warranty on most repairs</li>
        </ul>
      </div>
      <div class="lp-photo">
        <img
          src={brand.shopImage}
          alt="Queens Auto Service shop at 1303 Dundee Ave, Elgin, IL"
          loading="lazy"
          width="1904"
          height="640"
        />
      </div>
    </div>
  </section>

  <!-- ============ CTA BAND ============ -->
  <section class="lp-section">
    <div class="lp-wrap">
      <div class="lp-band reveal">
        <h2 class="lp-h2">Bad brakes draining your wallet? Get them fixed this week.</h2>
        <p class="mt-4 text-lg text-slate-200 max-w-2xl mx-auto">
          That squealing noise wrecking your peace of mind? We use
          industry-leading tech to diagnose and fix the problem with
          precision. Book online and get back to driving safe and worry-free.
        </p>
        <a href="#book" class="lp-btn mt-8">Book $369 Brake Service →</a>
      </div>
    </div>
  </section>

  <!-- ============ SERVICE AREA ============ -->
  <section class="lp-section">
    <div class="lp-wrap grid md:grid-cols-2 gap-10 lg:gap-16 items-center">
      <div>
        <h2 class="lp-h2">Proudly Serving Elgin &amp; the Surrounding Communities</h2>
        <div class="w-20 h-1 bg-[#0a79c8] mt-4 mb-6 rounded"></div>
        <ul class="grid grid-cols-2 gap-x-6 gap-y-3 text-slate-300">
          {
            cities.map((c) => (
              <li class="flex items-center gap-2">
