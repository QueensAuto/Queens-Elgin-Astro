---
/**
 * LandingLayout — stripped-down shell for paid-traffic landing pages.
 * No site navigation or footer links that lead visitors away from the offer.
 * Always dark. Keeps GTM, schema, fonts and ClientRouter (the booking form
 * initialises on `astro:page-load`) identical to BaseLayout.
 */
import { ClientRouter } from "astro:transitions";
import "../styles/fonts.css";
import "../styles/global.css";
import Schema from "../components/SEO/Schema.astro";
import type { BrandConfig } from "../brands";
import { mobileTiresBrand } from "../brands";

const {
  title,
  description = "",
  brand: propBrand,
  faqData,
  reviewData,
  noindex = false,
} = Astro.props;

const brand: BrandConfig = propBrand || mobileTiresBrand;
const phoneDigits = brand.phone.replace(/\D/g, "");
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en" class="dark" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b1121" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/png" href="/favicon.png" />

    <!-- Google Tag Manager -->
    <script is:inline>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != "dataLayer" ? "&l=" + l : "";
        j.async = true;
        j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, "script", "dataLayer", "GTM-W56FDLTF");
    </script>

    <!-- GTM virtual pageview + phone-click tracking (works with ClientRouter) -->
    <script is:inline>
      document.addEventListener("astro:page-load", () => {
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({
          event: "page_view",
          page_path: window.location.pathname,
          page_title: document.title,
        });
        document.querySelectorAll('a[href^="tel:"]').forEach((link) => {
          link.addEventListener("click", () => {
            window.dataLayer.push({
              event: "phone_click",
              phone_number: link.getAttribute("href").replace("tel:", ""),
              click_location: document.title,
            });
          });
        });
      });
    </script>

    <link
      rel="preload"
      href="/fonts/BigShoulders-VariableFont.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/InstrumentSans-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <title>{title}</title>
    <Schema
      brand={brand}
      title={title}
      description={description}
      faqData={faqData}
      reviewData={reviewData}
    />
    <ClientRouter />
    <slot name="head" />
  </head>
  <body
    class="bg-[#0b1121] text-slate-300 flex flex-col min-h-screen w-full overflow-x-hidden"
  >
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-W56FDLTF"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >

    <!-- Minimal header: logo + call + primary CTA -->
    <header class="lp-header">
      <div class="lp-wrap flex items-center justify-between gap-4 py-4">
        <a href="/brakes" aria-label={brand.name} class="shrink-0">
          <img
            src={brand.logoPathWhite}
            alt={brand.name}
            class="h-10 w-auto"
            width="1091"
            height="255"
          />
        </a>
        <div class="flex items-center gap-3 sm:gap-5">
          <a
            href={`tel:${phoneDigits}`}
            class="lp-call hidden sm:flex items-center gap-2 text-white font-semibold"
          >
            <svg
              class="w-4 h-4 text-[#6cafde]"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
              ></path></svg
            >
            {brand.phone}
          </a>
          <a href="#book" class="lp-btn lp-btn-sm">Claim Offer</a>
        </div>
      </div>
    </header>

    <main id="main-content" class="flex-grow">
      <slot />
    </main>

    <!-- Compact footer -->
    <footer class="lp-footer" id="lp-footer">
      <div class="lp-wrap py-12 text-center">
        <img
          src={brand.logoPathWhite}
          alt={brand.name}
          class="h-10 w-auto mx-auto mb-5"
          width="1091"
          height="255"
          loading="lazy"
        />
        <address class="not-italic text-slate-400 space-y-2">
          <p>
            <a
              href={brand.googleMapsUrl}
              target="_blank"
              rel="noreferrer"
              class="hover:text-[#6cafde] transition-colors">{brand.address}</a
            >
          </p>
          <p>
            Call us:{" "}
            <a
              href={`tel:${phoneDigits}`}
              class="text-white font-semibold hover:text-[#6cafde] transition-colors"
              >{brand.phone}</a
            >
          </p>
          <p class="text-sm text-slate-500">
            Mon–Fri 8:00 am – 6:00 pm &nbsp;|&nbsp; Sat 8:00 am – 4:00 pm
          </p>
        </address>
        <p class="mt-8 pt-6 border-t border-white/10 text-sm text-slate-500">
          &copy; {year}{" "}{brand.name} Elgin. All Rights Reserved.{" | "}
          <a href="/privacy" class="hover:text-[#6cafde]">Privacy Policy</a>{" | "}
          <a href="/terms" class="hover:text-[#6cafde]">Terms of Use</a>
        </p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  body {
    background-color: #0b1121 !important;
  }
  .lp-wrap {
    width: 100%;
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: 1.25rem;
  }
  @media (min-width: 1024px) {
    .lp-wrap {
      padding-inline: 2rem;
    }
  }

  .lp-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(11, 17, 33, 0.85);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .lp-footer {
    background: #000;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  /* Primary button — same gradient the Elgin booking form uses */
  .lp-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.95rem 2rem;
    border-radius: 9999px;
    font-weight: 700;
    font-size: 1.0625rem;
    color: #fff !important;
    text-decoration: none;
    background: linear-gradient(to right, #22d3ee, #3b82f6 60%);
    box-shadow: 0 10px 30px -10px rgba(34, 211, 238, 0.45);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }
  .lp-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 16px 34px -10px rgba(34, 211, 238, 0.6);
    text-decoration: none;
  }
  .lp-btn-sm {
    padding: 0.55rem 1.25rem;
    font-size: 0.9375rem;
  }
  .lp-btn-ghost {
    background: transparent;
    box-shadow: none;
    border: 1px solid rgba(255, 255, 255, 0.25);
  }
  .lp-btn-ghost:hover {
    background: rgba(255, 255, 255, 0.06);
    box-shadow: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .lp-btn,
    .lp-btn:hover {
      transition: none;
      transform: none;
    }
  }
</style>
